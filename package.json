{
  "name": "bio-downloader",
  "version": "2.0.47",
  "description": "Commercial Biology Raw Data Downloader Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/check-shared-sources.js && node scripts/check-web-bridge-contract.js && node scripts/check-linux-cli-contract.js && node scripts/check-cloud-workspace.js && node scripts/check-transfer-persistence.js && node scripts/check-transfer-resume.js && node scripts/check-partial-file.js && node scripts/check-download-integrity.js && node scripts/check-bio-transfer-guard.js && node scripts/check-download-fallback.js && node scripts/check-process-control.js && node scripts/check-batch-start.js && node scripts/check-manual-md5.js && node scripts/sync-linux-web.js --check && node scripts/check-speedtest.js && node scripts/check-linux-web-runtime.js && node scripts/check-installer-download.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test:desktop": "electron scripts/check-desktop-download.js",
    "build:linux": "node scripts/sync-linux-web.js && node scripts/build-linux.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandy9707/bio-downloader.git"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.biodl.downloader",
    "productName": "BioDownloader",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "extraction.html",
      "extraction.js",
      "logo.png",
      "img/group_qrcode.jpg",
      "speedtest.html",
      "shared/**/*",
      "package.json",
      "icons/**/*",
      "src/**/*",
      "cloud-preload.js"
    ],
    "mac": {
      "icon": "icons/icon.icns",
      "extraResources": [
        {
          "from": "bin/",
          "to": "bin/",
          "filter": [
            "Country.mmdb",
            "GeoSite.dat",
            "darwin/**/*"
          ]
        }
      ],
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "icons/icon.ico",
      "artifactName": "BioDownloader-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "bin/",
          "to": "bin/",
          "filter": [
            "Country.mmdb",
            "GeoSite.dat",
            "win32/**/*"
          ]
        }
      ],
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BioDownloader",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
